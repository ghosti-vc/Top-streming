{
  "id": "top-streming",
  "name": "Top Streaming",
  "version": "1.0.1",
  "apiVersion": 1,
  "entry": "plugin.js",
  "description": "Lo más visto de Netflix, HBO Max, Disney+, Prime Video y más: películas y series por país. Solo muestra el catálogo, no reproduce videos.",
  "author": "Ghosti-vc",
  "homepage": "https://github.com/Ghosti-vc/top-streming",
  "icon": "img.png",
  "hosts": [
    "api.themoviedb.org",
    "image.tmdb.org"
  ],
  "capabilities": [
    "home",
    "episodes",
    "resolve"
  ],
  "catalogOnly": true,
  "settings": [
    {
      "key": "region",
      "label": "País",
      "type": "select",
      "default": "MX",
      "options": [
        {
          "value": "MX",
          "label": "México"
        },
        {
          "value": "CO",
          "label": "Colombia"
        },
        {
          "value": "AR",
          "label": "Argentina"
        },
        {
          "value": "CL",
          "label": "Chile"
        },
        {
          "value": "PE",
          "label": "Perú"
        },
        {
          "value": "EC",
          "label": "Ecuador"
        },
        {
          "value": "VE",
          "label": "Venezuela"
        },
        {
          "value": "ES",
          "label": "España"
        },
        {
          "value": "US",
          "label": "Estados Unidos"
        }
      ]
    }
  ]
}
